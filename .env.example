# ─────────────────────────────────────────────────────────────────────────────
# mj41daily — environment
#
# Copy to .env.local for local development. On Vercel these go in
# Project Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Postgres. Vercel provides this automatically once you add a Postgres store
# (Storage → Create → Postgres). Without it the app runs but saves nothing.
DATABASE_URL=

# Neynar API key — Farcaster feed, notifications, user lookups.
# Regenerate from your own Neynar dashboard.
NEYNAR_API_KEY=

# Editor gate. Your Farcaster ID.
NEXT_PUBLIC_USER_FID=887819

# ── Recovered from the old deployment ────────────────────────────────────────

NEYNAR_WALLET_ID=zqoylhgpzj34nqc29aim8h78
NEYNAR_WALLET_ADDRESS=0x27df232b6f9029f8928a997b581b3642b4d3b903
NEXT_PUBLIC_NEYNAR_WALLET_ADDRESS=0x27df232b6f9029f8928a997b581b3642b4d3b903
WEBHOOK_URL=https://api.neynar.com/f/app/4a71b5c4-6cf0-4321-9638-0f8d033b6f8b/event

# The newsstand contract on Base. Sells the paper, burns 41 $RWACu per sale.
# Deployed 2026-09-01. Owner: 0x4146Fe6Da6B307E12ED7D2AB6c6a1bF5fBB4Fc41
NEXT_PUBLIC_NEWSSTAND_ADDRESS=0xC9A024a9cd1fEE36943b2ad62135a6DBcBab36F5

# ── Features ─────────────────────────────────────────────────────────────────

# Claude — AI story expansion, article rewriting, headline generation.
ANTHROPIC_API_KEY=

# Protects the cron routes. Vercel sends this automatically as
# "Authorization: Bearer <CRON_SECRET>" once the variable is set.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Protects the editor notification routes.
EDITOR_NOTIFY_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# The app falls back to a shared demo key if this is unset.
COINGECKO_API_KEY=

# Public RPCs are used when these are blank. Set them if you hit rate limits.
BASE_RPC_URL=
OPTIMISM_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Local development only — the tunnel or localhost URL the app is served from.
NEXT_PUBLIC_LOCAL_URL=
